{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "6f89aa8a9992a1d204dfbc09775047940a3256cd",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features",
      "hidden": false
    },
    {
      "type": "fix",
      "section": "Bug Fixes",
      "hidden": false
    }
  ],
  "packages": {
    "packages/next-nats": {
      "component": "@trogonstack/next-nats",
      "initial-version": "0.1.0"
