NATS_URL=nats://nats.next-nats.orb.local:4222
NATS_WORKERS=true

# Set one of NATS_USER, NATS_CREDS, NATS_NKEY or NATS_JWT. NATS_CREDS and NATS_NKEY take a path, file://, data:;base64, or env://NAME.
# NATS_JWT, NATS_SEED, NATS_TOKEN and NATS_PASSWORD are literals unless they start with file://, data: or env://.
# Secrets accept the plain value or the Secret Value Syntax: secret:[nid]:[nss]:[value]
# NATS_TOKEN=secret:nats:token:replace-me
# NATS_USER=app
# NATS_PASSWORD=secret:nats:password:replace-me
# NATS_NKEY=/run/secrets/user.nk
# NATS_CREDS=/run/secrets/nats.creds
# NATS_JWT=file:///run/secrets/user.jwt
# NATS_SEED=file:///run/secrets/user.seed
# BLOB_SECRET=secret:next-nats:blob:replace-me
# Signing secret for blob client tokens; BLOB_READ_WRITE_TOKEN is accepted as a fallback
# BLOB_READ_WRITE_TOKEN=secret:next-nats:blob:replace-me
# Absolute URL where the blob route is mounted; defaults to /blob
# NEXT_PUBLIC_BLOB_BASE_URL=http://localhost:3000/blob
