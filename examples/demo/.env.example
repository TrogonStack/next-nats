NATS_SERVERS=nats://nats.next-nats.orb.local:4222
NATS_WORKERS=true

# Secrets accept the plain value or the Secret Value Syntax: secret:[nid]:[nss]:[value]
# NATS_TOKEN=secret:nats:token:replace-me
# NATS_USER=app
# NATS_PASS=secret:nats:password:replace-me
# NATS_NKEY_SEED=secret:nats:nkey-seed:SU...
# NATS_CREDS=secret:nats:creds:<raw or base64 creds file>
# NATS_CREDS_FILE=/run/secrets/nats.creds
# BLOB_SECRET=secret:next-nats:blob:replace-me
# Signing secret for blob client tokens; BLOB_READ_WRITE_TOKEN is accepted as a fallback
# BLOB_READ_WRITE_TOKEN=secret:next-nats:blob:replace-me
# Absolute URL where the blob route is mounted; defaults to /blob
# NEXT_PUBLIC_BLOB_BASE_URL=http://localhost:3000/blob
