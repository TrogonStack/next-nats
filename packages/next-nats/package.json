{
  "name": "@trogonstack/next-nats",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./instrumentation": {
      "types": "./dist/instrumentation.d.ts",
      "default": "./dist/instrumentation.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "default": "./dist/redis/index.js"
    },
    "./kv": {
      "types": "./dist/kv/index.d.ts",
      "default": "./dist/kv/index.js"
    },
    "./blob": {
      "types": "./dist/blob/index.d.ts",
      "default": "./dist/blob/index.js"
    },
    "./blob/client": {
      "types": "./dist/blob/client.d.ts",
      "default": "./dist/blob/client.js"
    },
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "default": "./dist/queue/index.js"
    },
    "./edge-config": {
      "types": "./dist/edge-config/index.d.ts",
      "default": "./dist/edge-config/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "default": "./dist/cache/index.js"
    },
    "./cache/use-cache-handler": {
      "types": "./dist/cache/use-cache-handler.d.ts",
      "default": "./dist/cache/use-cache-handler.js"
    },
    "./cache/incremental-handler": {
      "types": "./dist/cache/incremental-handler.d.ts",
      "default": "./dist/cache/incremental-handler.js"
    },
    "./ratelimit": {
      "types": "./dist/ratelimit/index.d.ts",
      "default": "./dist/ratelimit/index.js"
    },
    "./realtime": {
      "types": "./dist/realtime/index.d.ts",
      "default": "./dist/realtime/index.js"
    },
    "./realtime/client": {
      "types": "./dist/realtime/client.d.ts",
      "default": "./dist/realtime/client.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "default": "./dist/services/index.js"
    },
    "./cron": {
      "types": "./dist/cron/index.d.ts",
      "default": "./dist/cron/index.js"
    },
    "./health/readiness": {
      "types": "./dist/health/readiness.d.ts",
      "default": "./dist/health/readiness.js"
    },
    "./health/liveness": {
      "types": "./dist/health/liveness.d.ts",
      "default": "./dist/health/liveness.js"
    },
    "./health": {
      "types": "./dist/health/index.d.ts",
      "default": "./dist/health/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/kv": "3.4.0",
    "@nats-io/nats-core": "3.4.0",
    "@nats-io/obj": "3.4.0",
    "@nats-io/services": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "cron-parser": "^5.10.2",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "@vercel/blob": "2.8.2",
    "@vercel/edge-config": "1.5.1",
    "@vercel/kv": "3.0.0",
    "@vercel/queue": "0.10.0",
    "fast-check": "4.10.2",
    "next": "16.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
